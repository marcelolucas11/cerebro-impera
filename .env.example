# Configuração NÃO secreta da instância. Copie para fora do repositório e preencha.
# Segredos (chave da instância, senhas do banco) nunca ficam aqui: são gerados no
# servidor por `cerebro-api init-secrets` e vivem só em CEREBRO_CONFIG_DIR.

CEREBRO_ENV=production
# Origem exata em que o app é servido (https obrigatório em produção).
CEREBRO_PUBLIC_ORIGIN=https://cerebro.exemplo.com
CEREBRO_HOST=127.0.0.1
CEREBRO_PORT=3000
# Quantos proxies reversos há na frente da API (normalmente 1: o Caddy ou o Nginx). Só esse
# número de entradas, da direita para a esquerda, vale no X-Forwarded-For: o que o próprio
# cliente escrever ali é ignorado. 0 ou "false" = nenhum proxy; "true" vale 1.
CEREBRO_TRUST_PROXY=1
# Requisições por minuto de cada sessão (ou endereço, antes de entrar). Acima disso, 429.
CEREBRO_REQUESTS_PER_MINUTE=1200
CEREBRO_CONFIG_DIR=/opt/cerebro/config
# Pasta com a página já compilada (apps/web/dist). Vazio = a API roda sozinha.
CEREBRO_WEB_ROOT=

# Anexos: pasta onde ficam (cifrados) e o maior arquivo aceito, em megabytes.
CEREBRO_FILES_DIR=/opt/cerebro/files
CEREBRO_MAX_ATTACHMENT_MB=2048
# Antivírus dos anexos. Vazio = anexos desligados até a escolha.
#   clamd://clamav:3310  ClamAV na rede interna (recomendado)
#   off                  sem antivírus: arquivos ficam marcados como não verificados
CEREBRO_ANTIVIRUS=

CEREBRO_DB_HOST=
CEREBRO_DB_PORT=5432
CEREBRO_DB_NAME=cerebro
CEREBRO_DB_ADMIN_USER=postgres

# Somente para rodar os testes: superusuário de um PostgreSQL 16+ descartável.
TEST_PG_ADMIN_URL=
